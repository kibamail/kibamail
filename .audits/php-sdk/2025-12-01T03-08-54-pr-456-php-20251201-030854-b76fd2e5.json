  "missingEndpoints": [
    {
      "path": "/v1/forms/{formId}/versions",
      "method": "GET",
      "operationId": "listFormVersions",
      "description": "List all versions of a specific form for version history and rollback",
      "specLocation": "Line 9025 in openapi.v1.json",
      "recommendation": "Add versions() method to Forms service",
      "suggestedCode": "/**\n * List all versions of a form.\n *\n * @param string $formId The root form ID\n * @return Collection<Form> List of form versions\n */\npublic function versions(string $formId): Collection\n{\n    $payload = Payload::list(\"v1/forms/{$formId}/versions\");\n    $result = $this->transporter->request($payload);\n\n    return $this->createResource('forms', $result);\n}"
    },
    {
      "path": "/v1/forms/{formId}/versions",
      "method": "POST",
      "operationId": "createFormVersion",
      "description": "Create a new draft version of a form for updating published forms",
      "specLocation": "Line 9025 in openapi.v1.json",
      "recommendation": "Add createVersion() method to Forms service",
      "suggestedCode": "/**\n * Create a new version of a form.\n *\n * @param string $formId The root form ID\n * @return Form The new draft form version\n */\npublic function createVersion(string $formId): Form\n{\n    $payload = Payload::create(\"v1/forms/{$formId}/versions\", []);\n    $result = $this->transporter->request($payload);\n\n    return $this->createResource('forms', $result);\n}"
    },
    {
      "path": "/v1/forms/{formId}/publish",
      "method": "POST",
      "operationId": "publishForm",
      "description": "Publish a draft form to make it live and accepting submissions",
      "specLocation": "Line 9631 in openapi.v1.json",
      "recommendation": "Add publish() method to Forms service",
      "suggestedCode": "/**\n * Publish a draft form.\n *\n * @param string $formId The form ID to publish\n * @return Form The published form\n */\npublic function publish(string $formId): Form\n{\n    $payload = Payload::create(\"v1/forms/{$formId}/publish\", []);\n    $result = $this->transporter->request($payload);\n\n    return $this->createResource('forms', $result);\n}"
    }
  ],

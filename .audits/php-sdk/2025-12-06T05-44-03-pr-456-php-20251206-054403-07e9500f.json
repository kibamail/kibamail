      "sdkFile": "src/Form.php",
      "sdkLine": 12,
      "openApiPath": "/v1/forms",
      "openApiOperation": "listForms",
      "issue": "Form model has incorrect status PHPDoc type",
      "expected": "OpenAPI spec defines status as enum: 'DRAFT', 'PUBLISHED', 'ARCHIVED'",
      "actual": "PHPDoc says status is 'active' or 'inactive'",
      "impact": "Developer confusion about valid status values",
      "recommendation": "Update PHPDoc to: @property-read string $status The form status ('DRAFT', 'PUBLISHED', or 'ARCHIVED')",
      "codeExample": "/**\n * @property-read string $status The form status ('DRAFT', 'PUBLISHED', or 'ARCHIVED')\n */"
    },
    {
      "id": "INC-002",

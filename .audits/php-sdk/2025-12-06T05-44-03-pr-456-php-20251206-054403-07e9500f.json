      "category": "request_schema",
      "service": "contacts",
      "sdkMethod": "search",
      "sdkFile": "src/Service/Contacts.php",
      "sdkLine": 110,
      "openApiPath": "/v1/contacts/search",
      "openApiOperation": "searchContacts",
      "issue": "Search method PHPDoc does not match OpenAPI request schema",
      "expected": "OpenAPI requires 'conditions' field with Condition schema (MongoDB-style query)",
      "actual": "PHPDoc shows 'query' and 'filters' fields which don't exist in spec",
      "impact": "Developers will use wrong parameter names causing API errors",
      "recommendation": "Update PHPDoc to match OpenAPI SearchContactsRequest schema",
      "codeExample": "/**\n * @param array{\n *     conditions: array,\n *     limit?: int,\n *     after?: string,\n *     before?: string\n * } $parameters Search parameters with MongoDB-style conditions\n */"
    },
    {
      "id": "INC-003",
      "severity": "major",
      "category": "request_schema",
      "service": "contactProperties",
      "sdkMethod": "update",
      "sdkFile": "src/Service/ContactProperties.php",
      "sdkLine": 59,
      "openApiPath": "/v1/contact-properties/{contactPropertyId}",
      "openApiOperation": "updateContactProperty",
      "issue": "Update method PHPDoc allows updating immutable fields",
      "expected": "OpenAPI spec states name and type are immutable - only defaultValue can be updated",
      "actual": "PHPDoc shows name and type as updatable parameters",
      "impact": "Developers will attempt to update immutable fields causing 400/409 errors",
      "recommendation": "Update PHPDoc to only show defaultValue as updatable",
      "codeExample": "/**\n * @param array{\n *     defaultValue?: string|null\n * } $parameters Contact property update parameters (name and type are immutable)\n */"
    },

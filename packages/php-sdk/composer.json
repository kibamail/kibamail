{
    "name": "kibamail/kibamail",
    "description": "Official PHP SDK for the Kibamail API",
    "keywords": ["kibamail", "email", "marketing", "api", "sdk"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Kibamail\\": "src/"
        },
        "files": [
            "src/Kibamail.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "../../test-sdk-infra/scripts/ensure-test-sdk-infra.sh && pest",
        "test:coverage": "../../test-sdk-infra/scripts/ensure-test-sdk-infra.sh && pest --coverage",
        "phpstan": "phpstan analyse src --level=5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

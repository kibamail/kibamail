{
  "name": "kibamail",
  "private": false,
  "version": "0.0.1-alpha.0",
  "description": "Official Node.js SDK for Kibamail API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo node_modules",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "publish:alpha": "npm publish --tag alpha",
    "schema:generate": "openapi-typescript ../../apps/web/public/openapi.v1.json -o ./schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "mock:start": "docker compose up -d",
    "mock:stop": "docker compose down",
    "mock:logs": "docker compose logs -f prism"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "keywords": [
    "kibamail",
    "email",
    "marketing",
    "api",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kibamail/kibamail-nodejs"
  },
  "license": "MIT",
  "dependencies": {
    "openapi-fetch": "^0.12.2",
    "openapi-typescript": "^7.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.10",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}

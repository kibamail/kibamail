{
  "name": "kibamail",
  "private": false,
  "version": "0.0.1-alpha.0",
  "description": "Official Node.js SDK for Kibamail API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "build:clean": "rm -rf dist && mkdir -p dist",
    "build:esm": "bun build ./index.ts --outfile=dist/index.mjs --target=node --format=esm --minify",
    "build:cjs": "bun build ./index.ts --outfile=dist/index.js --target=node --format=cjs --minify",
    "build:types": "bun run generate-dts.ts",
    "prepublishOnly": "bun run build",
    "publish:alpha": "npm publish --tag alpha",
    "schema:generate": "bun openapi-typescript ../../public/openapi.v1.json -o ./schema.d.ts"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "keywords": [
    "kibamail",
    "email",
    "marketing",
    "api",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kibamail/kibamail-nodejs"
  },
  "license": "MIT",
  "dependencies": {
    "openapi-fetch": "^0.12.2",
    "openapi-typescript": "^7.10.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}

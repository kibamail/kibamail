      "id": "header-overview",
      "title": "Overview",
      "panelTypes": "text",
      "query": {
        "builder": {
          "queryData": []
        }
      },
      "description": "Connection and cache metrics"
    },
    {
      "id": "total-connections",
      "title": "Total Connections",
      "panelTypes": "value",
      "query": {
        "builder": {
          "queryData": [
            {
              "aggregateOperator": "sum",
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateAttribute": {
                "key": "cnpg_pg_connections_total",
                "type": "Gauge"
              },
              "filters": {
                "items": [],
                "op": "AND"
              },
              "groupBy": [],
              "reduceTo": "last"
            }
          ]
        },
        "promql": [],
        "clickhouse_sql": []
      },
      "thresholds": [
        {"color": "#22c55e", "value": 0},
        {"color": "#eab308", "value": 80},
        {"color": "#ef4444", "value": 100}
      ]
    },

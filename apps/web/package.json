{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 18092",
    "build": "dotenvx run -f .env.prod -- next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo node_modules",
    "rbac:sync": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts",
    "rbac:sync:dry": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts --dry-run",
    "rbac:sync:force": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts --force",
    "outpost:types": "openapi-typescript https://raw.githubusercontent.com/hookdeck/outpost/refs/tags/v0.8.0/docs/apis/openapi.yaml -o ./webhooks/client/schema.ts",
    "logto:types": "openapi-typescript http://localhost:3001/api/.well-known/management.openapi.json -o ./auth/logto.types.ts",
    "seed": "dotenvx run -f .env.local -- tsx scripts/seed.ts",
    "seed:contacts": "dotenvx run -f .env.local -- tsx scripts/contact-seed.ts",
    "worker": "dotenvx run -f .env.local -- tsx jobs/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@dagrejs/dagre": "^1.1.8",
    "@del-wang/utils": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@dotenvx/dotenvx": "^1.51.1",
    "@kibamail/owly": "workspace:*",
    "@logto/api": "^1.33.0",
    "@logto/next": "^4.2.6",
    "@logto/node": "^3.1.6",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.1",
    "@repo/broadcast-editor": "workspace:*",
    "@repo/tracking-utils": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.7",
    "@tiptap/core": "^3.11.0",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/react": "^3.11.0",
    "@xyflow/react": "^12.9.3",
    "ajv": "^8.17.1",
    "bullmq": "^5.63.2",
    "cheerio": "^1.1.2",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "d3-dag": "^1.1.0",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "domhandler": "^5.0.3",
    "dotenv": "^17.2.3",
    "elkjs": "^0.11.0",
    "gravatar-url": "^4.0.1",
    "i18n-iso-countries": "^7.14.0",
    "iconoir-react": "^7.11.0",
    "ioredis": "^5.8.2",
    "leva": "^0.10.1",
    "libphonenumber-js": "^1.12.33",
    "next": "16.0.1",
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.10.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.0",
    "prisma-extension-soft-delete": "^2.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-email": "^5.0.8",
    "react-hook-form": "^7.66.0",
    "survey-core": "^2.3.15",
    "survey-react-ui": "^2.3.15",
    "ua-parser-js": "^2.0.6",
    "use-debounce": "^10.0.6",
    "usehooks-ts": "^3.1.1",
    "uuid": "^13.0.0",
    "xsta": "^3.0.1",
    "zenbox": "^2.1.1",
    "zod": "^4.1.12",
    "zod-openapi": "^5.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@faker-js/faker": "^10.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^4.0.10",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10"
  }
}

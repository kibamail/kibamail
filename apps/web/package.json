{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 18092",
    "build": "dotenvx run -f .env.prod -- next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check",
    "format": "biome format --write",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next .turbo node_modules",
    "rbac:sync": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts",
    "rbac:sync:dry": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts --dry-run",
    "rbac:sync:force": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts --force",
    "rbac:sync:dev": "dotenvx run -f .env.local -- tsx scripts/rbac-sync.ts --dev-users-and-orgs",
    "outpost:types": "openapi-typescript https://raw.githubusercontent.com/hookdeck/outpost/refs/tags/v0.8.0/docs/apis/openapi.yaml -o ./webhooks/client/schema.ts",
    "logto:types": "openapi-typescript http://localhost:3001/api/.well-known/management.openapi.json -o ./auth/logto.types.ts",
    "seed": "dotenvx run -f .env.local -- tsx scripts/seed.ts",
    "seed:contacts": "dotenvx run -f .env.local -- tsx scripts/contact-seed.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "worker": "dotenvx run -f .env.local -- tsx jobs/worker.ts",
    "knip": "knip",
    "manual-test:create-and-send": "dotenvx run -f .env.local -- tsx manual-tests/broadcasts/create-and-send.ts",
    "manual-test:send-with-template": "dotenvx run -f .env.local -- tsx manual-tests/transactional/send-with-template.ts"
  },

      "size": 35000,
      "response": {
        "code": 451,
        "enhanced_code": { "class": 4, "subject": 4, "detail": 5 },
        "content": "451 4.4.5 System congestion, try again later.",
        "command": "DATA"
      },
      "num_attempts": 5,
      "bounce_classification": "TransientFailure",
      "meta": { "tenant_id": "ws_001", "broadcast_id": "bc_001", "contact_id": "ct_007" }
    }
  ]

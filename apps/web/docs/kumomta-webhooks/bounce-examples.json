      },
      "bounce_classification": "BadDomain",
      "meta": {
        "tenant_id": "ws_001",
        "broadcast_id": "bc_001",
        "contact_id": "ct_004"
      }
    },
    {
      "_scenario": "Spam blocked - IP reputation",
      "type": "Bounce",
      "id": "bounce-005",
      "sender": "bounces+msg-005@bounce.acme.com",

      "queue": "example.com",
      "site": "mail.example.com",
      "size": 35000,
      "response": {
        "code": 550,
        "enhanced_code": { "class": 5, "subject": 2, "detail": 1 },
        "content": "550 5.2.1 The email account has been disabled.",
        "command": "RCPT TO"
      },
      "bounce_classification": "InactiveMailbox",
      "meta": {
        "tenant_id": "ws_001",
        "broadcast_id": "bc_001",
        "contact_id": "ct_003"
      }
    },
    {

{
  "_description": "Collection of various bounce scenarios with different classifications",
  "examples": [
    {
      "_scenario": "Invalid recipient - user does not exist",
      "type": "Bounce",
      "id": "bounce-001",
      "sender": "bounces+msg-001@bounce.acme.com",
      "recipient": "nobody@example.com",
      "queue": "example.com",
      "site": "mail.example.com",
      "size": 35000,
      "response": {
        "code": 550,
        "enhanced_code": { "class": 5, "subject": 1, "detail": 1 },
        "content": "550 5.1.1 The email account that you tried to reach does not exist.",
        "command": "RCPT TO"
      },
      "bounce_classification": "InvalidRecipient",
      "meta": {
        "tenant_id": "ws_001",
        "broadcast_id": "bc_001",
        "contact_id": "ct_001"
      }
    },
    {
      "_scenario": "Mailbox full - quota exceeded",
      "type": "Bounce",
      "id": "bounce-002",
      "sender": "bounces+msg-002@bounce.acme.com",
      "recipient": "fullbox@example.com",
      "queue": "example.com",
      "site": "mail.example.com",
      "size": 35000,
      "response": {
        "code": 552,
        "enhanced_code": { "class": 5, "subject": 2, "detail": 2 },
        "content": "552 5.2.2 The recipient's mailbox is full and cannot receive messages.",
        "command": "DATA"
      },
      "bounce_classification": "QuotaIssues",
      "meta": {
        "tenant_id": "ws_001",
        "broadcast_id": "bc_001",
        "contact_id": "ct_002"
      }
    },
    {
      "_scenario": "Inactive mailbox - account disabled",

# TiDB Multi-Instance Configuration
# Copy this file to .env.local and adjust the values as needed

# TiDB Connection Settings
TIDB_HOST=localhost
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=tidb_benchmark

# TiDB Port Range (ports 4000-4010 by default)
TIDB_START_PORT=4000
TIDB_END_PORT=4010

# Connection Pool Settings
TIDB_CONNECTION_LIMIT=10

# Worker Configuration
WORKER_COUNT=50
BATCH_SIZE=100
TOTAL_INSERTS=100000

# Performance Tuning
INSERT_DELAY_MS=10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invitation {
  /// Unique identifier for the invitation record
  id                String           @id @default(cuid())
  /// Logto's invitation ID (from Management API response)
  logtoInvitationId String           @unique
  /// Logto organization ID (workspace)
  workspaceId       String
  /// Email address of the invitee
  inviteeEmail      String
  /// Invitation status
  status            InvitationStatus @default(PENDING)
  /// When the invitation expires (Unix timestamp in milliseconds)
  expiresAt         DateTime
  /// When the invitation was created
  createdAt         DateTime         @default(now())
  /// When the invitation was last updated
  updatedAt         DateTime         @updatedAt

  @@index([inviteeEmail])
  @@index([workspaceId])
  @@index([expiresAt])
  @@index([status])
  @@map("invitations")
}

/// *
///  * API Keys Schema
///  *
///  * Stores API keys for workspace authentication to the public API.
///  * Uses scope-based permissions independent of the internal RBAC system.
model ApiKey {
  id          String    @id @default(cuid())
  /// Workspace ID from Logto (organization ID)
  workspaceId String
  /// User-provided name for the API key
  name        String
  /// SHA-256 hash of the API key
  /// The actual key is never stored, only the hash
  keyHash     String    @unique
  /// Preview of the key (first 8 chars after prefix)
  /// Format: "kb_abc12345..."
  /// Used for identification in the UI
  keyPreview  String
  /// Array of scope names granted to this key
  /// @example ["read:contacts", "write:broadcasts"]
  scopes      Json
  /// Last time this key was used to make an API request
  lastUsedAt  DateTime?
  /// When the key was created
  createdAt   DateTime  @default(now())
  /// When the key was last updated
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([keyHash])
  @@index([createdAt])
  @@map("api_keys")
}

/// *
///  * Contacts Schema
///  *
///  * Core contact entity storing subscriber information and status.
///  * Each contact belongs to a workspace and can have multiple topics,
///  * tags, and be part of various segments.
model Contact {
  /// Unique identifier for the contact
  id               String            @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId      String
  /// Contact's email address (required)
  email            String
  /// Contact's first name
  firstName        String?
  /// Contact's last name
  lastName         String?
  /// Contact's phone number
  phone            String?
  /// Contact's country
  country          String?
  /// Contact's timezone
  timezone         String?
  /// Contact's city
  city             String?
  /// Contact subscription status
  status           ContactStatus     @default(SUBSCRIBED)
  /// Source type indicating how the contact was created
  sourceType       ContactSourceType @default(MANUAL)
  /// Source ID (form ID for FORM source, import ID for IMPORT source, null for MANUAL/API)
  sourceId         String?
  /// When the contact was subscribed
  subscribedAt     DateTime?
  /// When the contact was unsubscribed
  unsubscribedAt    DateTime?
  /// Token for confirming email subscription (double opt-in)
  confirmationToken String?
  /// When the contact was created
  createdAt         DateTime          @default(now())
  /// When the contact was last updated
  updatedAt                 DateTime          @updatedAt
  /// Custom property slots - Float (30 slots for dates and numbers)
  propertyFloat0   Float?
  propertyFloat1   Float?
  propertyFloat2   Float?
  propertyFloat3   Float?
  propertyFloat4   Float?
  propertyFloat5   Float?
  propertyFloat6   Float?
  propertyFloat7   Float?
  propertyFloat8   Float?
  propertyFloat9   Float?
  propertyFloat10  Float?
  propertyFloat11  Float?
  propertyFloat12  Float?
  propertyFloat13  Float?
  propertyFloat14  Float?
  propertyFloat15  Float?
  propertyFloat16  Float?
  propertyFloat17  Float?
  propertyFloat18  Float?
  propertyFloat19  Float?
  propertyFloat20  Float?
  propertyFloat21  Float?
  propertyFloat22  Float?
  propertyFloat23  Float?
  propertyFloat24  Float?
  propertyFloat25  Float?
  propertyFloat26  Float?
  propertyFloat27  Float?
  propertyFloat28  Float?
  propertyFloat29  Float?
  propertyFloat30  Float?
  propertyFloat31  Float?
  propertyFloat32  Float?
  propertyFloat33  Float?
  propertyFloat34  Float?
  /// Custom property slots - String (50 slots)
  propertyString0  String?
  propertyString1  String?
  propertyString2  String?
  propertyString3  String?
  propertyString4  String?
  propertyString5  String?
  propertyString6  String?
  propertyString7  String?
  propertyString8  String?
  propertyString9  String?
  propertyString10 String?
  propertyString11 String?
  propertyString12 String?
  propertyString13 String?
  propertyString14 String?
  propertyString15 String?
  propertyString16 String?
  propertyString17 String?
  propertyString18 String?
  propertyString19 String?
  propertyString20 String?
  propertyString21 String?
  propertyString22 String?
  propertyString23 String?
  propertyString24 String?
  propertyString25 String?
  propertyString26 String?
  propertyString27 String?
  propertyString28 String?
  propertyString29 String?
  propertyString30 String?
  propertyString31 String?
  propertyString32 String?
  propertyString33 String?
  propertyString34 String?
  propertyString35 String?
  propertyString36 String?
  propertyString37 String?
  propertyString38 String?
  propertyString39 String?
  propertyString40 String?
  propertyString41 String?
  propertyString42 String?
  propertyString43 String?
  propertyString44 String?
  propertyString45 String?
  propertyString46 String?
  propertyString47 String?
  propertyString48 String?
  propertyString49 String?
  segments         ContactSegment[]
  topics           ContactTopic[]
  suppressions     SuppressionList[]
  automationRuns   AutomationRun[]
  formSubmissions  FormSubmission[]
  conversations    Conversation[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([subscribedAt])
  @@index([workspaceId, propertyFloat0])
  @@index([workspaceId, propertyFloat1])
  @@index([workspaceId, propertyFloat2])
  @@index([workspaceId, propertyFloat3])
  @@index([workspaceId, propertyFloat4])
  @@index([workspaceId, propertyFloat5])
  @@index([workspaceId, propertyFloat6])
  @@index([workspaceId, propertyFloat7])
  @@index([workspaceId, propertyFloat8])
  @@index([workspaceId, propertyFloat9])
  @@index([workspaceId, propertyString0])
  @@index([workspaceId, propertyString1])
  @@index([workspaceId, propertyString2])
  @@index([workspaceId, propertyString3])
  @@index([workspaceId, propertyString4])
  @@index([workspaceId, propertyString5])
  @@index([workspaceId, propertyString6])
  @@index([workspaceId, propertyString7])
  @@index([workspaceId, propertyString8])
  @@index([workspaceId, propertyString9])
  @@index([sourceType])
  @@index([sourceId])
  @@index([confirmationToken])
  @@map("contacts")
}

/// *
///  * Contact Properties Schema
///  *
///  * Defines custom properties that can be assigned to contacts.
///  * Each property is mapped to a pre-allocated slot on the contacts table.
///  * The slot assignment is managed internally and not exposed via API.
model ContactProperty {
  /// Unique identifier for the contact property
  id           String              @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId  String
  /// User-facing property name
  name         String
  /// Internal slot name (e.g., "propertyNum0", "propertyDate5", "propertyString12")
  /// This determines which column on the contacts table stores this property's values
  slot         String
  /// Property type (determines validation rules and slot prefix)
  type         ContactPropertyType
  /// Default value for this property (stored as string, validated based on type)
  /// For date type: Unix timestamp in milliseconds
  /// For number type: Decimal number as string
  /// For string type: String value
  defaultValue String?
  /// Soft delete timestamp (NULL = active, non-NULL = deleted)
  deletedAt    DateTime?           @map("deleted_at")
  /// When the property was created
  createdAt    DateTime            @default(now())
  /// When the property was last updated
  updatedAt    DateTime            @updatedAt

  @@unique([workspaceId, name])
  @@unique([workspaceId, slot])
  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([type])
  @@map("contact_properties")
}

/// *
///  * Topics Schema
///  *
///  * Topics represent different categories or interests that contacts
///  * can subscribe to. Each topic has a unique slug per workspace
///  * and can be either public or private.
model Topic {
  /// Unique identifier for the topic
  id           String            @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId  String
  /// Topic name
  name         String
  /// Topic description
  description  String?
  /// Topic visibility (public topics can be seen by all, private are internal)
  visibility   TopicVisibility   @default(PUBLIC)
  /// Whether contacts are opted in by default when subscribed to this topic
  defaultOptIn Boolean           @default(false)
  /// When the topic was created
  createdAt    DateTime          @default(now())
  /// When the topic was last updated
  updatedAt    DateTime          @updatedAt
  /// Soft delete timestamp (NULL = active, non-NULL = deleted)
  deletedAt    DateTime?         @map("deleted_at")
  contacts     ContactTopic[]
  suppressions SuppressionList[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([visibility])
  @@map("topics")
}

/// *
///  * Contact Topics Junction Table
///  *
///  * Manages the many-to-many relationship between contacts and topics,
///  * tracking subscription status for each contact-topic pair.
model ContactTopic {
  /// Unique identifier for the relationship
  id        String                  @id @default(cuid())
  /// Reference to the contact
  contactId String
  /// Reference to the topic
  topicId   String
  /// Subscription status for this contact-topic relationship
  status    TopicSubscriptionStatus @default(SUBSCRIBED)
  /// When the subscription was created
  createdAt DateTime                @default(now())
  /// When the subscription was last updated
  updatedAt DateTime                @updatedAt
  contact   Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  topic     Topic                   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([contactId, topicId])
  @@index([contactId])
  @@index([topicId])
  @@index([status])
  @@map("contact_topics")
}

/// *
///  * Segments Schema
///  *
///  * Segments allow grouping contacts based on specific criteria.
///  * Dynamic segments use conditions to automatically include/exclude contacts,
///  * while static segments maintain a fixed list of contacts.
model Segment {
  /// Unique identifier for the segment
  id          String           @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId String
  /// Segment name
  name        String
  /// Segment description
  description String?
  /// Segment type (dynamic segments use conditions, static are manually managed)
  type        SegmentType      @default(DYNAMIC)
  /// JSON representation of the query conditions for dynamic segments
  /// Contains the logic used to determine segment membership
  /// @example {"and": [{"field": "status", "operator": "equals", "value": "subscribed"}]}
  conditions  Json?
  /// When the segment was created
  createdAt   DateTime         @default(now())
  /// When the segment was last updated
  updatedAt   DateTime         @updatedAt
  /// Soft delete timestamp (NULL = active, non-NULL = deleted)
  deletedAt   DateTime?        @map("deleted_at")
  contacts    ContactSegment[]

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@index([type])
  @@map("segments")
}

/// *
///  * Contact Segments Junction Table
///  *
///  * Manages the many-to-many relationship between contacts and static segments.
///  * Dynamic segments don't use this table as membership is determined by conditions.
model ContactSegment {
  /// Unique identifier for the relationship
  id        String   @id @default(cuid())
  /// Reference to the contact
  contactId String
  /// Reference to the segment
  segmentId String
  /// When the contact was added to the segment
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  segment   Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([contactId, segmentId])
  @@index([contactId])
  @@index([segmentId])
  @@map("contact_segments")
}

/// *
///  * Suppression List Schema
///  *
///  * Suppression list per workspace to prevent sending emails
///  * to specific contacts. Can be scoped globally (all emails)
///  * or to specific topics only. This is crucial for compliance
///  * and avoiding spam complaints.
model SuppressionList {
  /// Unique identifier for the suppression entry
  id          String            @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId String
  /// Reference to the contact being suppressed
  contactId   String?
  /// Email address to suppress (for cases where contact might not exist)
  email       String
  /// Suppression scope - global or topic-specific
  scope       SuppressionScope  @default(GLOBAL)
  /// Topic ID if scope is TOPIC (null for global suppressions)
  topicId     String?
  /// Reason for suppression
  reason      SuppressionReason
  /// Optional notes about the suppression
  notes       String?
  /// When the suppression was created
  createdAt   DateTime          @default(now())
  /// When the suppression was last updated
  updatedAt   DateTime          @updatedAt
  contact     Contact?          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  topic       Topic?            @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email, topicId])
  @@index([workspaceId])
  @@index([contactId])
  @@index([email])
  @@index([scope])
  @@index([topicId])
  @@index([reason])
  @@map("suppression_list")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
}

enum ContactStatus {
  UNCONFIRMED
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  ARCHIVED
}

/// Source type indicating how a contact was created
enum ContactSourceType {
  MANUAL // Created manually via dashboard
  IMPORT // Created via CSV/file import
  FORM // Created via form submission
  API // Created via API call
}

/// *
///  * Contact Import Schema
///  *
///  * Stores contact import jobs from CSV files.
///  * The import is processed asynchronously by a background job.
///  * Tracks progress, statistics, and any errors that occur.
model ContactImport {
  /// Unique identifier for the import
  id             String              @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId    String
  /// S3 file key for the uploaded CSV
  fileKey        String
  /// Original filename
  fileName       String
  /// File size in bytes
  fileSize       Int
  /// Import status
  status         ContactImportStatus @default(PENDING)
  /// Column mapping configuration (CSV column -> contact field)
  /// @example {"email": "Email Address", "firstName": "First Name", "lastName": "Last Name", "customProperties": {"Company": "propertyString0"}}
  columnMapping  Json
  /// Topic IDs to subscribe imported contacts to
  /// @example ["topic_123", "topic_456"]
  topicIds       Json                @default("[]")
  /// Whether to auto-subscribe all imported contacts
  autoSubscribe  Boolean             @default(false)
  /// Whether to update existing contacts if email already exists
  updateExisting Boolean             @default(false)
  /// Total number of rows in the CSV (excluding header)
  totalRows      Int                 @default(0)
  /// Number of rows successfully processed
  processedRows  Int                 @default(0)
  /// Number of contacts created
  createdCount   Int                 @default(0)
  /// Number of contacts updated
  updatedCount   Int                 @default(0)
  /// Number of rows skipped (duplicates when updateExisting is false)
  skippedCount   Int                 @default(0)
  /// Number of rows that failed to process
  failedCount    Int                 @default(0)
  /// Error details for failed rows (stored as JSON array)
  /// @example [{"row": 5, "error": "Invalid email format"}, {"row": 12, "error": "Missing required field"}]
  errors         Json                @default("[]")
  /// Error message if the entire import failed
  errorMessage   String?
  /// When processing started
  startedAt      DateTime?
  /// When processing completed
  completedAt    DateTime?
  /// When the import was created
  createdAt      DateTime            @default(now())
  /// When the import was last updated
  updatedAt      DateTime            @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, status])
  @@map("contact_imports")
}

/// Contact import status
enum ContactImportStatus {
  PENDING // Waiting to be configured
  QUEUED // Ready and waiting in queue
  PROCESSING // Currently being processed
  COMPLETED // Successfully completed
  FAILED // Processing failed
  CANCELLED // Cancelled by user
}

enum ContactPropertyType {
  DATE
  NUMBER
  STRING
}

enum TopicVisibility {
  PUBLIC
  PRIVATE
}

enum TopicSubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

enum SegmentType {
  DYNAMIC
  STATIC
}

enum SuppressionScope {
  GLOBAL
  TOPIC
}

enum SuppressionReason {
  MANUAL
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  LEGAL_REQUEST
  INVALID_EMAIL
}

/// *
///  * Automation Schema
///  *
///  * Represents an automation workflow (journey) that contacts can enter.
///  * Uses React Flow for visual workflow building (stores nodes and edges as JSON).
///  * Supports versioning - only one DRAFT and one PUBLISHED version at a time.
///  * Competitive with Mailchimp, Klaviyo, and SendGrid automation capabilities.
model Automation {
  /// Unique identifier for the automation
  id            String            @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId   String
  /// Automation name
  name          String
  /// Automation description
  description   String?
  /// Current status of this version
  status        AutomationStatus  @default(DRAFT)
  /// Version number (increments with each new version)
  version       Int               @default(1)
  /// Reference to parent automation ID (for version grouping)
  /// NULL for the first version, references the original automation ID for subsequent versions
  parentId      String?
  /// Trigger type that starts the automation
  triggerType   AutomationTrigger
  /// JSON configuration for the trigger (segment IDs, event names, conditions, etc.)
  /// @example {"segmentId": "seg_123"}
  /// @example {"event": "purchase_completed", "propertyName": "total", "operator": "greater_than", "value": 100}
  triggerConfig Json?
  /// React Flow nodes (triggers, actions, rules)
  /// @example [{"id": "1", "type": "form-filled", "position": {"x": 0, "y": 0}, "data": {...}}]
  nodes         Json              @default("[]")
  /// React Flow edges (connections between nodes)
  /// @example [{"id": "e1-2", "source": "1", "target": "2", "sourceHandle": null, "targetHandle": null}]
  edges         Json              @default("[]")
  /// Settings for the automation (timezone, send windows, frequency caps, etc.)
  /// @example {"timezone": "UTC", "sendWindow": {"start": "09:00", "end": "17:00"}, "maxEntriesPerContact": 1}
  settings      Json?
  /// Statistics for this version (total runs, completions, etc.)
  /// @example {"totalRuns": 1500, "completedRuns": 1200, "activeRuns": 300}
  stats         Json?             @default("{}")
  /// When this version was published (NULL if never published)
  publishedAt   DateTime?
  /// When the automation version was created
  createdAt     DateTime          @default(now())
  /// When the automation version was last updated
  updatedAt     DateTime          @updatedAt
  /// Soft delete timestamp (NULL = active, non-NULL = deleted)
  deletedAt     DateTime?         @map("deleted_at")
  /// Parent automation (for version tracking)
  parent        Automation?       @relation("AutomationVersions", fields: [parentId], references: [id], onDelete: Cascade)
  /// Child versions
  versions      Automation[]      @relation("AutomationVersions")
  /// Automation runs (contact journeys)
  runs          AutomationRun[]

  @@unique([workspaceId, parentId, status], name: "one_status_per_parent")
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@index([parentId])
  @@index([triggerType])
  @@index([version])
  @@map("automations")
}

/// *
///  * Automation Run Schema
///  *
///  * Tracks a contact's journey through an automation version.
///  * Records entry, progress, completion, and any errors.
///  * Stores execution state as JSON (current node, completed nodes, pending nodes).
model AutomationRun {
  /// Unique identifier for the run
  id             String              @id @default(cuid())
  /// Automation ID this run belongs to
  automationId   String
  /// Contact going through the automation
  contactId      String
  /// Workspace ID for tenant segregation
  workspaceId    String
  /// Current status of the run
  status         AutomationRunStatus @default(ACTIVE)
  /// Current node ID the contact is on (from React Flow nodes)
  currentNodeId  String?
  /// Execution state (completed nodes, pending nodes, branch decisions, etc.)
  /// @example {"completedNodes": ["node-1", "node-2"], "pendingNodes": ["node-3"], "branchDecisions": {"if-else-1": "true"}}
  executionState Json?
  /// When the contact entered the automation
  startedAt      DateTime            @default(now())
  /// When the automation run completed (success or failure)
  completedAt    DateTime?
  /// When the next scheduled action should occur (for time delays)
  scheduledAt    DateTime?
  /// Error message if the run failed
  errorMessage   String?
  /// Metadata about the run (entry trigger data, custom attributes, execution history, etc.)
  /// @example {"entrySource": "segment", "segmentId": "seg_123", "nodeExecutions": [{...}]}
  metadata       Json?
  /// When the run was created
  createdAt      DateTime            @default(now())
  /// When the run was last updated
  updatedAt      DateTime            @updatedAt
  /// Parent automation version
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// Contact
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([automationId, contactId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([contactId])
  @@index([status])
  @@index([currentNodeId])
  @@index([startedAt])
  @@index([completedAt])
  @@index([scheduledAt])
  @@map("automation_runs")
}

/// Automation version status
/// Only one DRAFT and one PUBLISHED version can exist per automation at a time
enum AutomationStatus {
  DRAFT // Draft version being edited
  PUBLISHED // Published version (active)
  ARCHIVED // Archived version (replaced by newer published version)
}

/// Automation trigger types
enum AutomationTrigger {
  CONTACT_SUBSCRIBED // Contact subscribed
  PROPERTY_UPDATED // Contact property updated
  FORM_SUBMITTED // Form submitted
  API // Triggered via API call
  EVENT // Custom event occurs
  SEGMENT_ENTRY // Contact enters a segment
  SEGMENT_EXIT // Contact exits a segment
  EMAIL_ENGAGEMENT // Email opened, clicked, etc.
}

/// Automation node types (from React Flow)
enum AutomationNodeType {
  // Triggers
  FORM_FILLED // Trigger: Form filled (form-filled)
  CONTACT_SUBSCRIBED // Trigger: Contact subscribed (contact-subscribed)
  CONTACT_PROPERTY_UPDATED // Trigger: Contact property updated (contact-property-updated)
  WEBHOOK_TRIGGER // Trigger: Webhook trigger (webhook-trigger)

  // Actions
  SEND_EMAIL // Action: Send email (send-email)
  SEND_WEBHOOK // Action: Send webhook (send-webhook)
  UPDATE_CONTACT // Action: Update contact (update-contact)
  UNSUBSCRIBE_CONTACT // Action: Unsubscribe contact (unsubscribe-contact)
  ADD_TO_TOPIC // Action: Add to topic (add-to-topic)
  REMOVE_FROM_TOPIC // Action: Remove from topic (remove-from-topic)

  // Rules
  IF_ELSE // Rule: If/else condition (if-else)
  PERCENTAGE_SPLIT // Rule: Percentage split / A/B test (percentage-split)
  TIME_DELAY // Rule: Time delay / wait (time-delay)
}

/// Automation run status
enum AutomationRunStatus {
  ACTIVE // Currently running
  COMPLETED // Successfully completed
  FAILED // Failed with error
  CANCELLED // Manually cancelled
  PAUSED // Paused (e.g., waiting for time delay)
}

/// *
///  * Forms Schema
///  *
///  * Represents forms that can be embedded on websites to collect contact information.
///  * Form fields are stored as JSON and mapped to submission flat columns.
///  * Supports versioning - only one DRAFT and one PUBLISHED version at a time.
///  * Competitive with Typeform, Mailchimp forms, and ConvertKit forms.
model Form {
  /// Unique identifier for the form
  id                 String      @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId        String
  /// Form name
  name               String
  /// Form description
  description        String?
  /// Form type (sign-up for collecting subscribers, survey for collecting information)
  type               FormType    @default(SIGN_UP)
  /// Form display mode (how the form is presented to users)
  display            FormDisplay @default(INLINE_EMBED)
  /// Form status
  status             FormStatus  @default(DRAFT)
  /// Version number (increments with each new version)
  version            Int         @default(1)
  /// Reference to parent form ID (for version grouping)
  /// NULL for the first version, references the original form ID for subsequent versions
  parentId           String?
  /// Reference to the currently published version (for root forms only)
  /// Points to the active published version that should be shown on the public endpoint
  publishedVersionId String?
  /// Form fields configuration stored as JSON
  /// Each field defines its name, type, validation, and which submission slot it maps to
  /// @example [{"id": "field-1", "name": "email", "type": "email", "label": "Email Address", "required": true, "slot": "fieldString0"}]
  fields             Json        @default("[]")
  /// Form settings (success message, redirect URL, double opt-in, etc.)
  /// @example {"successMessage": "Thank you!", "redirectUrl": "https://example.com/thank-you", "doubleOptIn": true, "createContact": true}
  settings           Json?
  /// Field mapping for submission storage - maps form field names to database slots
  /// Populated at publish time. Slot assignments are permanent per root form for data integrity.
  /// @example {"email": {"slot": "fieldString0", "type": "string"}, "age": {"slot": "fieldNum0", "type": "number"}}
  fieldMapping       Json?
  /// Double opt-in confirmation email ID
  doubleOptInEmailId String?

  /// SEO page title for the public form page
  seoTitle           String?          @db.VarChar(200)
  /// SEO meta description for the public form page
  seoDescription     String?          @db.VarChar(500)
  /// SEO Open Graph image URL for social sharing
  seoImageUrl        String?          @db.VarChar(2000)
  /// Favicon URL for the public form page
  seoFaviconUrl      String?          @db.VarChar(2000)
  /// Custom URL slug for the public form page (e.g., forms.kibamail.com/my-form)
  slug               String?          @db.VarChar(100)

  /// When this version was published (NULL if never published)
  publishedAt             DateTime?
  /// When the form was created
  createdAt               DateTime         @default(now())
  /// When the form was last updated
  updatedAt               DateTime         @updatedAt
  /// Soft delete timestamp (NULL = active, non-NULL = deleted)
  deletedAt               DateTime?        @map("deleted_at")
  /// Parent form (for version tracking)
  parent                  Form?            @relation("FormVersions", fields: [parentId], references: [id], onDelete: Cascade)
  /// Child versions
  versions                Form[]           @relation("FormVersions")
  /// Currently published version (for root forms only)
  publishedVersion        Form?            @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  /// Forms that reference this as published version
  referencedByAsPublished Form[]           @relation("PublishedVersion")
  /// Double opt-in confirmation email
  doubleOptInEmail        Email?           @relation("FormDoubleOptInEmail", fields: [doubleOptInEmailId], references: [id], onDelete: SetNull)
  /// Form submissions
  submissions             FormSubmission[]
  /// Page views for this form
  pageViews               PageView[]

  // Only enforce uniqueness for DRAFT and PUBLISHED status (allow multiple ARCHIVED)
  // This allows version rollback/rollforward without constraint violations
  @@unique([workspaceId, slug], name: "forms_workspace_slug_unique")
  @@index([workspaceId, parentId, status], name: "forms_workspace_parent_status_idx")
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, deletedAt])
  @@index([parentId])
  @@index([slug])
  @@map("forms")
}

/// *
///  * Form Submissions Schema
///  *
///  * Stores form submission data using flat columns for custom fields.
///  * Similar to contacts, uses pre-allocated slots that are mapped from form fields.
///  * The slot assignment is defined in the form's fields JSON configuration.
model FormSubmission {
  /// Unique identifier for the submission
  id             String               @id @default(cuid())
  /// Form ID this submission belongs to
  formId         String
  /// Workspace ID for tenant segregation
  workspaceId    String
  /// Contact ID if submission created/updated a contact
  contactId      String?
  /// Submission status
  status         FormSubmissionStatus @default(PENDING)
  /// IP address of the submitter
  ipAddress      String?
  /// User agent of the submitter
  userAgent      String?
  /// Referrer URL
  referrerUrl    String?
  /// Landing page URL where form was submitted
  landingPageUrl String?
  /// When the submission was created
  createdAt      DateTime             @default(now())
  /// When the submission was last updated
  updatedAt      DateTime             @updatedAt
  /// Custom field slots - String (40 slots)
  fieldString0   String?
  fieldString1   String?
  fieldString2   String?
  fieldString3   String?
  fieldString4   String?
  fieldString5   String?
  fieldString6   String?
  fieldString7   String?
  fieldString8   String?
  fieldString9   String?
  fieldString10  String?
  fieldString11  String?
  fieldString12  String?
  fieldString13  String?
  fieldString14  String?
  fieldString15  String?
  fieldString16  String?
  fieldString17  String?
  fieldString18  String?
  fieldString19  String?
  fieldString20  String?
  fieldString21  String?
  fieldString22  String?
  fieldString23  String?
  fieldString24  String?
  fieldString25  String?
  fieldString26  String?
  fieldString27  String?
  fieldString28  String?
  fieldString29  String?
  fieldString30  String?
  fieldString31  String?
  fieldString32  String?
  fieldString33  String?
  fieldString34  String?
  fieldString35  String?
  fieldString36  String?
  fieldString37  String?
  fieldString38  String?
  fieldString39  String?
  /// Custom field slots - Numeric (15 slots for dates and numbers)
  fieldNum0      Float?
  fieldNum1      Float?
  fieldNum2      Float?
  fieldNum3      Float?
  fieldNum4      Float?
  fieldNum5      Float?
  fieldNum6      Float?
  fieldNum7      Float?
  fieldNum8      Float?
  fieldNum9      Float?
  fieldNum10     Float?
  fieldNum11     Float?
  fieldNum12     Float?
  fieldNum13     Float?
  fieldNum14     Float?

  /// Parent form
  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  /// Contact associated with this submission (for SIGN_UP forms)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([formId])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, fieldString0])
  @@index([workspaceId, fieldString1])
  @@index([workspaceId, fieldString2])
  @@index([workspaceId, fieldString3])
  @@index([workspaceId, fieldString4])
  @@index([workspaceId, fieldNum0])
  @@index([workspaceId, fieldNum1])
  @@index([workspaceId, fieldNum2])
  @@index([workspaceId, fieldNum3])
  @@index([workspaceId, fieldNum4])
  @@map("form_submissions")
}

/// *
///  * Page Views Schema
///  *
///  * Tracks page views for forms and landing pages.
///  * Used to calculate conversion rates and analyze visitor behavior.
model PageView {
  /// Unique identifier for the page view
  id          String       @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId String
  /// Form ID (optional - for form page views)
  formId      String?
  /// Page type being viewed
  pageType    PageViewType @default(FORM)
  /// IP address of the visitor
  ipAddress   String?
  /// Raw user agent string
  userAgent   String?
  /// Detected device type (desktop, mobile, tablet)
  device      String?
  /// Detected operating system
  os          String?
  /// Detected browser
  browser     String?
  /// Country (derived from IP)
  country     String?
  /// City (derived from IP)
  city        String?
  /// Referrer URL
  referrerUrl String?
  /// When the page was viewed
  createdAt   DateTime     @default(now())

  /// Parent form
  form Form? @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([formId])
  @@index([createdAt])
  @@index([workspaceId, formId])
  @@index([workspaceId, createdAt])
  @@map("page_views")
}

/// Page view type
enum PageViewType {
  FORM // Form page view
  LANDING_PAGE // Landing page view (future)
}

/// Form status
enum FormStatus {
  DRAFT // Draft form being edited
  PUBLISHED // Published form (active and accepting submissions)
  ARCHIVED // Archived form (no longer accepting submissions)
}

/// Form type
enum FormType {
  SIGN_UP // Sign-up form for collecting subscribers
  SURVEY // Survey form for collecting information
}

/// Form display mode
enum FormDisplay {
  POPUP // Popup/modal form
  INLINE_EMBED // Inline embedded form
}

/// Form submission status
enum FormSubmissionStatus {
  PENDING // Pending processing
  PROCESSED // Successfully processed
  SPAM // Marked as spam
  FAILED // Processing failed
}

/// *
///  * Sending Domains Schema
///  *
///  * Manages email sending infrastructure configuration.
///  * Stores all configuration needed for proper email authentication and tracking.
///  * Each sending domain contains DKIM keys, return path settings, and tracking domain config.
model SendingDomain {
  /// Unique identifier for the sending domain
  id                          String           @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId                 String
  /// Domain name (e.g., "example.com")
  name                        String
  /// DKIM subdomain prefix (e.g., "kiba" for kiba._domainkey.example.com)
  dkimSubDomain               String
  /// DKIM public key for DNS TXT record
  dkimPublicKey               String
  /// DKIM private key (encrypted) for signing emails
  dkimPrivateKey              String
  /// When DKIM was verified
  dkimVerifiedAt              DateTime?
  /// Return path subdomain for bounce handling (e.g., "bounce" for bounce.example.com)
  returnPathSubDomain         String
  /// CNAME value for return path domain
  returnPathDomainCnameValue  String
  /// When return path domain was verified
  returnPathDomainVerifiedAt  DateTime?
  /// Tracking subdomain for click/open tracking (e.g., "track" for track.example.com)
  trackingSubDomain           String
  /// CNAME value for tracking domain
  trackingDomainCnameValue    String
  /// When tracking domain CNAME was verified
  trackingDomainVerifiedAt    DateTime?
  /// When tracking domain SSL was verified
  trackingDomainSslVerifiedAt DateTime?
  /// DMARC reporting shortcode (10 lowercase chars) for aggregate reports
  dmarcReportingCode          String
  /// When DMARC record was verified
  dmarcVerifiedAt             DateTime?
  /// SSL certificate key (encrypted)
  trackingSslCertKey          String?          @db.Text
  /// SSL certificate secret (encrypted)
  trackingSslCertSecret       String?          @db.Text
  /// ACME challenge token for SSL certificate validation
  trackingSslChallengeToken   String?
  /// ACME challenge key authorization (encrypted)
  trackingSslChallengeAuth    String?          @db.Text
  /// SSL certificate issuance status: "pending" | "in_progress" | "completed" | "failed"
  sslIssuanceStatus           String?
  /// Error message when SSL issuance fails
  sslIssuanceError            String?
  /// When SSL issuance job started
  sslIssuanceStartedAt        DateTime?
  /// Whether open tracking is enabled for this domain
  openTrackingEnabled         Boolean          @default(false)
  /// Whether click tracking is enabled for this domain
  clickTrackingEnabled        Boolean          @default(false)
  /// Maximum emails allowed per day (warmup limit, -1 = unlimited)
  maxSendPerDay               Int              @default(100)
  /// Maximum emails allowed per hour (warmup limit, -1 = unlimited)
  maxSendPerHour              Int              @default(10)
  /// When DNS records were last verified
  recordsLastVerifiedAt       DateTime?
  /// When the sending domain was created
  createdAt                   DateTime         @default(now())
  /// When the sending domain was last updated
  updatedAt                   DateTime         @updatedAt
  /// Whether inbox (receiving replies) is enabled for this domain
  inboxEnabled                Boolean          @default(true)
  /// When inbox MX record was verified
  inboxMxVerifiedAt           DateTime?
  /// Sender identities using this domain
  senderIdentities            SenderIdentity[]
  /// Broadcasts using this domain
  broadcasts                  Broadcast[]
  /// Events using this domain
  events                      Event[]
  /// Conversations using this domain
  conversations               Conversation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// *
///  * Sender Identities Schema
///  *
///  * Manages reusable sender information for emails.
///  * Stores predefined sender profiles that users can select when sending broadcasts.
model SenderIdentity {
  /// Unique identifier for the sender identity
  id                             String        @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId                    String
  /// Sender name (used as "From" name in emails)
  name                           String
  /// Sender email (local part, combined with sending domain)
  email                          String
  /// Sending domain for the email address
  sendingDomainId                String
  /// Verification code for email verification
  emailVerificationCode          String?
  /// When email was verified
  emailVerifiedAt                DateTime?
  /// When verification code expires
  emailVerificationCodeExpiresAt DateTime?
  /// Reply-to email address (optional, different from sender email)
  replyToEmail                   String?
  /// When the sender identity was created
  createdAt                      DateTime      @default(now())
  /// When the sender identity was last updated
  updatedAt                      DateTime      @updatedAt
  /// Sending domain relation
  sendingDomain                  SendingDomain @relation(fields: [sendingDomainId], references: [id], onDelete: Cascade)
  /// Broadcasts using this sender identity as From
  broadcastsAsSender             Broadcast[]   @relation("BroadcastSender")
  /// Broadcasts using this sender identity as Reply-To
  broadcastsAsReplyTo            Broadcast[]   @relation("BroadcastReplyTo")
  /// Events using this sender identity
  events                         Event[]
  /// Conversations using this sender identity
  conversations                  Conversation[]

  @@index([workspaceId])
}

/// *
///  * Email Contents Schema
///  *
///  * Stores email content in multiple formats (JSON, HTML, text).
///  * Shared by broadcasts and A/B test variants.
model EmailContent {
  /// Unique identifier for the email content
  id             String          @id @default(cuid())
  /// JSON content (for editor state)
  contentJson    Json?
  /// Editor styles configuration (canvas styles)
  styles         Json?
  /// Plain text content
  contentText    String?
  /// HTML content
  contentHtml    String?
  /// Email subject line
  subject        String?
  /// Preview text (shown in inbox preview)
  previewText    String?
  /// When the content was last updated
  updatedAt      DateTime?       @updatedAt
  /// When the content was created
  createdAt      DateTime        @default(now())
  /// Broadcasts using this content
  broadcasts     Broadcast[]
  /// A/B test variants using this content
  abTestVariants AbTestVariant[]
}

/// *
///  * Broadcasts Schema
///  *
///  * Represents email campaigns that can be sent to contacts.
///  * Supports A/B testing, scheduling, and tracking.
model Broadcast {
  /// Unique identifier for the broadcast
  id                      String           @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId             String
  /// Broadcast name
  name                    String
  /// Segment ID for targeting (optional)
  segmentId               String?
  /// Topic ID for targeting (optional)
  topicId                 String?
  /// Whether to track clicks
  trackClicks             Boolean?
  /// Whether to track opens
  trackOpens              Boolean?
  /// Email content for the broadcast
  emailContentId          String?
  /// Sender identity for the broadcast
  senderIdentityId        String?
  /// Reply-to sender identity for the broadcast
  replyToIdentityId       String?
  /// Sending domain for the broadcast
  sendingDomainId         String?
  /// Winning A/B test variant ID (set after test completes)
  winningAbTestVariantId  String?
  /// Hours to wait before picking A/B test winner
  waitingTimeToPickWinner Int?             @default(4)
  /// Broadcast status
  status                  BroadcastStatus  @default(DRAFT)
  /// Whether this is an A/B test broadcast
  isAbTest                Boolean          @default(false)
  /// Criteria for picking A/B test winner
  winningCriteria         WinningCriteria?
  /// Time to wait before picking winner (in hours)
  winningWaitTime         Int?
  /// Scheduled send time
  sendAt                  DateTime?
  /// When the broadcast was created
  createdAt               DateTime         @default(now())
  /// When the broadcast was last updated
  updatedAt               DateTime         @updatedAt
  /// Email content relation
  emailContent            EmailContent?    @relation(fields: [emailContentId], references: [id], onDelete: SetNull)
  /// Sender identity relation
  senderIdentity          SenderIdentity?  @relation("BroadcastSender", fields: [senderIdentityId], references: [id], onDelete: SetNull)
  /// Reply-to sender identity relation
  replyToIdentity         SenderIdentity?  @relation("BroadcastReplyTo", fields: [replyToIdentityId], references: [id], onDelete: SetNull)
  /// Sending domain relation
  sendingDomain           SendingDomain?   @relation(fields: [sendingDomainId], references: [id], onDelete: SetNull)
  /// A/B test variants for this broadcast
  abTestVariants          AbTestVariant[]
  /// Events for this broadcast
  events                  Event[]

  @@index([workspaceId])
}

/// *
///  * A/B Test Variants Schema
///  *
///  * Stores variants for A/B testing in broadcasts.
///  * Each variant has its own email content and weight.
model AbTestVariant {
  /// Unique identifier for the variant
  id             String       @id @default(cuid())
  /// Parent broadcast
  broadcastId    String
  /// Email content for this variant
  emailContentId String
  /// Variant name (e.g., "Variant A", "Variant B")
  name           String
  /// Weight percentage for distribution (1-100)
  weight         Int          @default(1)
  /// Scheduled send time for this variant (for staggered sends)
  sendAt         DateTime?
  /// When the variant was created
  createdAt      DateTime     @default(now())
  /// When the variant was last updated
  updatedAt      DateTime     @updatedAt
  /// Parent broadcast relation
  broadcast      Broadcast    @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  /// Email content relation
  emailContent   EmailContent @relation(fields: [emailContentId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
}

/// *
///  * Events Schema
///  *
///  * Unified event tracking for all email-related activities.
///  * When an email is queued, a Queued event is created with email metadata.
///  * Subsequent events (Delivery, Bounce, Open, Click) reference the same sendingId.
model Event {
  /// Unique identifier for the event
  id                          String          @id @default(cuid())
  /// MTA sending ID - groups all events for the same email
  sendingId                   String?
  /// Workspace ID for tenant segregation
  workspaceId                 String
  /// Event type
  type                        EventType       @default(Any)
  /// When the event occurred
  createdAt                   DateTime        @default(now())

  // === References ===
  /// Sending domain used
  sendingDomainId             String?
  /// Broadcast this event belongs to
  broadcastId                 String?
  /// Contact ID for the recipient
  contactId                   String?
  /// Sender identity used for this email
  senderIdentityId            String?

  // === Email details (populated on Queued event) ===
  /// Recipient email address
  recipient                   String?
  /// MTA queue name
  queue                       String?
  /// Site name (MTA identifier)
  siteName                    String?
  /// Email size in bytes
  size                        Int?
  /// Total delivery attempts
  totalAttempts               Int?
  /// Links in the email (for click tracking)
  links                       Json?
  /// Node ID (MTA node identifier)
  nodeId                      String?
  /// Egress pool name
  egressPool                  String?
  /// Egress source address
  egressSource                String?
  /// Delivery protocol (SMTP, etc.)
  deliveryProtocol            String?
  /// Reception protocol
  receptionProtocol           String?
  /// Whether click tracking is enabled
  clickTrackingEnabled        Boolean?
  /// Whether open tracking is enabled
  openTrackingEnabled         Boolean?

  // === Response details (for delivery events) ===
  /// SMTP response code
  responseCode                Int?
  /// SMTP response content
  responseContent             String?
  /// SMTP response command
  responseCommand             String?
  /// Enhanced status code - class
  responseEnhancedCodeClass   Int?
  /// Enhanced status code - subject
  responseEnhancedCodeSubject Int?
  /// Enhanced status code - detail
  responseEnhancedCodeDetail  Int?

  // === Peer address ===
  /// Peer address name (receiving server)
  peerAddressName             String?
  /// Peer address IP
  peerAddressAddr             String?

  // === Bounce classification ===
  /// Bounce classification (hard, soft, etc.)
  bounceClassification        String?

  // === Analytics (for opens/clicks) ===
  /// Origin country
  originCountry               String?
  /// Origin state
  originState                 String?
  /// Origin city
  originCity                  String?
  /// Device type
  originDevice                String?
  /// Browser type
  originBrowser               String?

  // === Relations ===
  /// Sending domain relation
  sendingDomain               SendingDomain?  @relation(fields: [sendingDomainId], references: [id], onDelete: SetNull)
  /// Sender identity relation
  senderIdentity              SenderIdentity? @relation(fields: [senderIdentityId], references: [id], onDelete: SetNull)
  /// Broadcast relation
  broadcast                   Broadcast?      @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([sendingId])
  @@index([workspaceId])
  @@index([broadcastId])
  @@index([contactId])
  @@index([type])
  @@index([createdAt])
  @@map("events")
}

/// Broadcast status
enum BroadcastStatus {
  DRAFT // Draft broadcast being edited
  QUEUED_FOR_SENDING // Queued and waiting to be sent
  SENDING // Currently being sent
  SENT // Successfully sent
  SENDING_FAILED // Sending failed
  DRAFT_ARCHIVED // Archived draft
  ARCHIVED // Archived sent broadcast
}

/// A/B test winning criteria
enum WinningCriteria {
  OPENS // Winner based on open rate
  CLICKS // Winner based on click rate
  CONVERSIONS // Winner based on conversion rate
}

/// Event types
enum EventType {
  Queued // Email queued for sending
  Delivery // Email delivered
  Reception // Email received by MTA
  Bounce // Email bounced
  TransientFailure // Temporary failure
  Expiration // Email expired
  AdminBounce // Admin bounce
  OOB // Out of band bounce
  Feedback // Feedback loop (complaint)
  Rejection // Email rejected
  AdminRebind // Admin rebind
  Any // Any/unknown event
  Click // Link clicked
  Open // Email opened
  Unsubscribed // Contact unsubscribed via clicking unsubscribe link
  ListUnsubscribe // Contact unsubscribed via RFC 8058 one-click (email client)
}

/// *
///  * Email Schema
///  *
///  * Reusable email templates for transactional and automated emails.
///  * Used for: double opt-in confirmations, automation emails, notifications.
///  * Decoupled from broadcasts to allow reuse across different contexts.
model Email {
  /// Unique identifier for the email
  id                String    @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId       String
  /// Internal name for identification
  name              String
  /// Email subject line
  subject           String?
  /// Preview text (shown in inbox preview)
  previewText       String?
  /// JSON content (TipTap editor state)
  content           Json?
  /// Editor styles configuration
  styles            Json?
  /// Sender identity ID
  senderIdentityId  String?
  /// Reply-to identity ID
  replyToIdentityId String?
  /// Whether to track clicks
  trackClicks       Boolean   @default(true)
  /// Whether to track opens
  trackOpens        Boolean   @default(true)
  /// Email type for categorization
  type              EmailType @default(TRANSACTIONAL)
  /// When the email was created
  createdAt         DateTime  @default(now())
  /// When the email was last updated
  updatedAt         DateTime  @updatedAt

  /// Forms using this as double opt-in email
  formsAsDoubleOptIn Form[] @relation("FormDoubleOptInEmail")

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@map("emails")
}

/// Email type for categorization
enum EmailType {
  TRANSACTIONAL // Double opt-in, password reset, etc.
  AUTOMATION // Emails in automation flows
  NOTIFICATION // System notifications
}

/// *
///  * Conversation Schema
///  *
///  * Represents a two-way email conversation thread.
///  * Created when an outbound email is sent (if inbox is enabled).
///  * Can also be created for unsolicited inbound emails (orphan conversations).
model Conversation {
  /// Unique identifier for the conversation
  id                String                 @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId       String
  /// Contact ID (nullable for orphan conversations from unsolicited emails)
  contactId         String?
  /// Sender identity used for this conversation (nullable for orphan conversations)
  senderIdentityId  String?
  /// Sending domain for this conversation
  sendingDomainId   String

  /// Type of origin that started this conversation
  originType        ConversationOriginType
  /// ID of the origin (broadcast ID, email ID, automation ID, etc.) - null for unsolicited
  originId          String?
  /// The first outbound emailSendId that started this conversation - null for unsolicited
  originEmailSendId String?                @unique

  /// Conversation subject (from original email)
  subject           String
  /// When the last message was sent/received
  lastMessageAt     DateTime
  /// Total number of messages in conversation
  messageCount      Int                    @default(1)
  /// Number of unread messages
  unreadCount       Int                    @default(0)
  /// Conversation status
  status            ConversationStatus     @default(OPEN)

  /// When the conversation was created
  createdAt         DateTime               @default(now())
  /// When the conversation was last updated
  updatedAt         DateTime               @updatedAt

  /// Contact relation
  contact           Contact?               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// Sender identity relation
  senderIdentity    SenderIdentity?        @relation(fields: [senderIdentityId], references: [id], onDelete: Cascade)
  /// Sending domain relation
  sendingDomain     SendingDomain          @relation(fields: [sendingDomainId], references: [id], onDelete: Cascade)
  /// Messages in this conversation
  messages          InboxMessage[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, lastMessageAt])
  @@index([contactId])
  @@index([senderIdentityId])
  @@index([sendingDomainId])
  @@map("conversations")
}

/// *
///  * Inbox Message Schema
///  *
///  * Stores individual messages within a conversation.
///  * Can be either inbound (reply from contact) or outbound (sent from platform).
model InboxMessage {
  /// Unique identifier for the message
  id                   String             @id @default(cuid())
  /// Workspace ID for tenant segregation
  workspaceId          String
  /// Conversation this message belongs to
  conversationId       String

  /// Message direction (inbound or outbound)
  direction            MessageDirection
  /// Email send ID for correlation
  emailSendId          String
  /// The emailSendId this message is replying to (for threading)
  inReplyToEmailSendId String?

  /// Sender email address
  fromEmail            String
  /// Sender name
  fromName             String?
  /// Recipient email address
  toEmail              String
  /// Recipient name
  toName               String?

  /// Email subject
  subject              String
  /// Plain text body
  textBody             String?            @db.Text
  /// HTML body
  htmlBody             String?            @db.Text
  /// Raw RFC822 email (for inbound debugging)
  rawEmail             String?            @db.Text
  /// S3 key for large content storage
  contentS3Key         String?

  /// RFC822 Message-ID header
  messageId            String?
  /// In-Reply-To header value
  inReplyToHeader      String?
  /// References header value
  referencesHeader     String?            @db.Text

  /// Message status
  status               InboxMessageStatus @default(UNREAD)
  /// When MTA received the message (inbound)
  receivedAt           DateTime?
  /// When the message was sent (outbound)
  sentAt               DateTime?
  /// When the message was read
  readAt               DateTime?

  /// When the message was created
  createdAt            DateTime           @default(now())
  /// When the message was last updated
  updatedAt            DateTime           @updatedAt

  /// Conversation relation
  conversation         Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Attachments for this message
  attachments          InboxAttachment[]

  @@index([workspaceId])
  @@index([conversationId])
  @@index([emailSendId])
  @@index([workspaceId, status])
  @@index([conversationId, createdAt])
  @@map("inbox_messages")
}

/// *
///  * Inbox Attachment Schema
///  *
///  * Stores metadata for message attachments.
///  * Actual files are stored in S3.
model InboxAttachment {
  /// Unique identifier for the attachment
  id             String       @id @default(cuid())
  /// Message this attachment belongs to
  inboxMessageId String

  /// Original filename
  filename       String
  /// MIME content type
  contentType    String
  /// File size in bytes
  size           Int
  /// S3 key for the file
  s3Key          String
  /// Content-ID for inline attachments (CID)
  contentId      String?
  /// Whether this is an inline attachment
  isInline       Boolean      @default(false)

  /// When the attachment was created
  createdAt      DateTime     @default(now())

  /// Message relation
  message        InboxMessage @relation(fields: [inboxMessageId], references: [id], onDelete: Cascade)

  @@index([inboxMessageId])
  @@map("inbox_attachments")
}

/// Conversation origin type - what started the conversation
enum ConversationOriginType {
  BROADCAST // Started from a broadcast email
  DOUBLE_OPT_IN // Started from a double opt-in confirmation
  AUTOMATION // Started from an automation email
  TRANSACTIONAL // Started from a transactional email
  UNSOLICITED // Unsolicited inbound email (no matching outbound)
}

/// Conversation status
enum ConversationStatus {
  OPEN // Active conversation
  CLOSED // Manually closed
  ARCHIVED // Archived
}

/// Message direction
enum MessageDirection {
  INBOUND // Reply from contact
  OUTBOUND // Sent from platform
}

/// Inbox message status
enum InboxMessageStatus {
  UNREAD // Not yet read
  READ // Read by user
  ARCHIVED // Archived
}


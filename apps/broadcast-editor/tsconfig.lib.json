{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "verbatimModuleSyntax": false
  },
  "include": [
    "lib/index.ts",
    "src/components/tiptap-templates/email-editor/**/*",
    "src/components/tiptap-node/**/*",
    "src/components/tiptap-ui/**/*",
    "src/components/tiptap-ui-primitive/**/*",
    "src/components/tiptap-ui-utils/**/*",
    "src/components/tiptap-extension/**/*",
    "src/components/tiptap-icons/**/*",
    "src/contexts/**/*",
    "src/hooks/**/*",
    "src/lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/App.tsx",
    "src/main.tsx"
  ]
}

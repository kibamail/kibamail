# Managed by Ansible - do not edit manually
# Generated: {{ ansible_date_time.iso8601 }}
# Server: {{ inventory_hostname }}
# Hetzner vSwitch VLAN configuration
network:
  version: 2
  renderer: networkd
  vlans:
    {{ vswitch_physical_interface }}.{{ vswitch_vlan_id }}:
      id: {{ vswitch_vlan_id }}
      link: {{ vswitch_physical_interface }}
      mtu: {{ vswitch_mtu }}
      addresses:
        - {{ vswitch_private_ip }}/{{ vswitch_private_subnet | ansible.utils.ipaddr('prefix') }}

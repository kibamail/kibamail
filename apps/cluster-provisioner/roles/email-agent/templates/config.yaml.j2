# Email Agent Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# NOTE: Secrets (S3 credentials, API keys) are loaded from environment variables
# via the systemd EnvironmentFile. See /etc/email-agent/email-agent.env
---
agent:
  hostname: "{{ inventory_hostname }}"
  log_level: "{{ email_agent_log_level }}"
  log_format: "{{ email_agent_log_format }}"
  # app_key loaded from KIBAMAIL_AGENT_AGENT_APP_KEY env var

nats:
  urls:
    # Use vswitch private IP since that's where NATS is listening
    - "nats://{{ vswitch_private_ip }}:{{ nats_client_port }}"
  nkey_file: "{{ email_agent_nats_config_dir }}/kibamail-agent.nkeys"
  tls_enabled: {{ email_agent_nats_tls_enabled | lower }}
  tls_ca_cert: "{{ email_agent_nats_config_dir }}/ca.pem"
  tls_cert: "{{ email_agent_nats_config_dir }}/client.pem"
  tls_key: "{{ email_agent_nats_config_dir }}/client-key.pem"
  max_reconnects: -1
  reconnect_wait: 2s

http:
  host: "{{ email_agent_http_host }}"
  port: {{ email_agent_http_port }}
  read_timeout: 30s
  write_timeout: 30s
  shutdown_timeout: 30s

redis:
  # Use localhost since email-agent and Redis are on the same server
  host: "127.0.0.1"
  port: {{ redis_port }}
  password: "{{ redis_password | default('') }}"
  db: 0
  dial_timeout: 5s
  pool_size: 10

# S3 configuration
s3:
  endpoint: "{{ email_agent_s3_endpoint }}"
  region: "{{ email_agent_s3_region }}"
  access_key_id: "{{ email_agent_s3_access_key_id }}"
  secret_access_key: "{{ email_agent_s3_secret_access_key }}"
  bucket: "{{ email_agent_s3_bucket }}"
  force_path_style: true

kumomta:
  endpoint: "{{ email_agent_kumomta_endpoint }}"
  timeout: {{ email_agent_kumomta_timeout }}
  max_idle_conns: 100
  max_conns_per_host: 100
  deferred_generation: true

# Control API configuration
control_api:
  base_url: "{{ email_agent_control_api_base_url }}"
  api_key: "{{ email_agent_control_api_key }}"
  timeout: 10s

worker:
  stream_name: "{{ email_agent_stream_name }}"
  consumer_name: "{{ email_agent_consumer_name }}"
  filter_subject: "{{ email_agent_filter_subject }}"
  fetch_batch: {{ email_agent_fetch_batch }}
  fetch_workers: {{ email_agent_fetch_workers }}
  ack_timeout: 30s
  max_retries: 5

metrics:
  enabled: {{ email_agent_metrics_enabled | lower }}
  port: {{ email_agent_metrics_port }}
  path: "/metrics"

health:
  enabled: {{ email_agent_health_enabled | lower }}
  port: {{ email_agent_health_port }}
  liveness_path: "/live"
  readiness_path: "/ready"

# OpenTelemetry configuration
# Sends traces and metrics to local OTel Collector which forwards to SigNoz
otel:
  enabled: {{ email_agent_otel_enabled | lower }}
  endpoint: "{{ email_agent_otel_endpoint }}"
  insecure: {{ email_agent_otel_insecure | lower }}
  service_name: "{{ email_agent_otel_service_name }}"
  environment: "{{ email_agent_otel_environment }}"

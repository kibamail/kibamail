# Email Agent systemd service
# Generated by Ansible - DO NOT EDIT MANUALLY

[Unit]
Description=Kibamail Email Agent
Documentation=https://github.com/kibamail/email-agent
After=network-online.target nats.service redis.service
Wants=network-online.target
Requires=nats.service

[Service]
Type=simple
User={{ email_agent_user }}
Group={{ email_agent_group }}
ExecStart=/usr/local/bin/email-agent --config {{ email_agent_config_dir }}/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Environment
Environment="GOMAXPROCS={{ ansible_processor_vcpus | default(4) }}"

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

# Read-write paths
ReadWritePaths={{ email_agent_log_dir }}

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=email-agent

[Install]
WantedBy=multi-user.target

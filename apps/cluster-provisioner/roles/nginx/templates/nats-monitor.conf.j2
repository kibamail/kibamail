# NATS HTTPS Monitoring Proxy
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# This configuration provides HTTPS access to NATS monitoring endpoint.
# Hostname: {{ nginx_nats_hostname }}

upstream nats_monitor_backend {
    server {{ nginx_nats_upstream_host }}:{{ nats_http_port }};
}

server {
    listen {{ ansible_host }}:{{ nginx_nats_monitor_port }} ssl;
    server_name {{ nginx_nats_hostname }};

    # TLS Configuration
    ssl_certificate {{ nginx_tls_dir }}/fullchain.pem;
    ssl_certificate_key {{ nginx_tls_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    location / {
        proxy_pass http://nats_monitor_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ nginx_proxy_connect_timeout }};
        proxy_read_timeout {{ nginx_proxy_timeout }};
    }

    # Health check endpoint
    location /healthz {
        proxy_pass http://nats_monitor_backend/healthz;
        proxy_http_version 1.1;
    }
}

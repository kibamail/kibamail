# Email Agent Metrics HTTPS Proxy
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# This configuration provides HTTPS access to email-agent Prometheus metrics.
# Hostname: {{ nginx_agent_metrics_hostname }}

upstream agent_metrics_backend {
    server {{ nginx_agent_metrics_upstream_host }}:{{ nginx_agent_metrics_upstream_port }};
}

server {
    listen {{ ansible_host }}:{{ nginx_agent_metrics_port }} ssl;
    server_name {{ nginx_agent_metrics_hostname }};

    # TLS Configuration
    ssl_certificate {{ nginx_agent_tls_dir }}/fullchain.pem;
    ssl_certificate_key {{ nginx_agent_tls_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Prometheus metrics endpoint
    location /metrics {
        proxy_pass http://agent_metrics_backend/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout {{ nginx_proxy_connect_timeout }};
        proxy_read_timeout {{ nginx_proxy_timeout }};
    }

    # Health check endpoint
    location /health {
        proxy_pass http://agent_metrics_backend/live;
        proxy_http_version 1.1;
    }

    # Root redirects to metrics
    location / {
        return 301 /metrics;
    }
}

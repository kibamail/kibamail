# {{ nginx_injection_domain }} - HTTP Injection Proxy
# Managed by Ansible - do not edit manually
#
# Proxies authenticated requests to KumoMTA HTTP injection endpoint
# Authentication via {{ nginx_injection_secret_header }} header

# Map to validate injection key (evaluated once per request, no subrequest)
map $http_{{ nginx_injection_secret_header | lower | replace('-', '_') }} $injection_auth_valid {
    default         0;
    "{{ injection_secret_key }}" 1;
}

server {
    listen 443 ssl http2;
    server_name {{ nginx_injection_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ nginx_injection_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_injection_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;

    # Health check endpoint (no auth required)
    # Returns 200 if KumoMTA is responding (even with 404)
    # Returns 503 if KumoMTA is unreachable
    location = /health {
        access_log off;
        proxy_pass http://127.0.0.1:{{ kumomta_http_port }}/;
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
        proxy_intercept_errors on;

        # Any response from KumoMTA means it's alive - return 200
        error_page 400 401 403 404 405 408 =200 @mta_healthy;
        # Connection failures mean KumoMTA is down - return 503
        error_page 502 503 504 =503 @mta_down;
    }

    location @mta_healthy {
        default_type text/plain;
        return 200 'ok';
    }

    location @mta_down {
        default_type text/plain;
        return 503 'MTA unavailable';
    }

    location / {
        # Reject if key is missing or invalid (no subrequest, pure nginx)
        if ($injection_auth_valid = 0) {
            return 403;
        }

        proxy_pass http://127.0.0.1:{{ kumomta_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-running injection requests
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}

server {
    listen 80;
    server_name {{ nginx_injection_domain }};
    return 301 https://$server_name$request_uri;
}
